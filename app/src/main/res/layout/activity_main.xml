<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo_principal">

    <!-- Barra de color arriba del todo, pegada, sin márgenes laterales -->
    <View
        android:id="@+id/view_indicador_color"
        android:layout_width="match_parent"
        android:layout_height="12dp"
        android:background="@drawable/bg_indicador_color"
        android:backgroundTint="@color/estado_sin_datos"/>

    <!-- Contenido central con scroll por si la tarjeta es larga -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="100dp"
            android:paddingBottom="40dp">

            <!-- Mensaje de estado GPS -->
            <TextView
                android:id="@+id/tv_estado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="48dp"
                android:textSize="16sp"
                android:textAlignment="center"
                android:textColor="@color/texto_secundario"
                android:text="Obteniendo ubicación..."/>

            <!-- Icono ubicación -->
            <ImageView
                android:id="@+id/tv_icono_ubicacion"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginTop="32dp"
                android:src="@drawable/ic_location"
                android:contentDescription="Ubicación"
                android:visibility="gone"/>

            <!-- Nombre municipio -->
            <TextView
                android:id="@+id/tv_municipio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="36sp"
                android:textStyle="bold"
                android:textColor="@color/texto_principal"
                android:textAlignment="center"
                android:visibility="gone"/>

            <!-- Provincia -->
            <TextView
                android:id="@+id/tv_provincia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="16sp"
                android:textColor="@color/texto_secundario"
                android:visibility="gone"/>

            <!-- Tarjeta normativa -->
            <androidx.cardview.widget.CardView
                android:id="@+id/card_normativa"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/fondo_tarjeta"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Badge estado -->
                    <TextView
                        android:id="@+id/tv_badge_estado"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="4dp"
                        android:paddingBottom="4dp"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/blanco"
                        android:background="@drawable/bg_badge_estado"/>

                    <!-- Resumen normativa -->
                    <TextView
                        android:id="@+id/tv_norma"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:textSize="15sp"
                        android:lineSpacingMultiplier="1.4"
                        android:textColor="@color/texto_principal"/>

                    <!-- Separador -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:background="@color/separador"/>

                    <!-- Fecha -->
                    <TextView
                        android:id="@+id/tv_fecha"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="12sp"
                        android:textColor="@color/texto_secundario"/>

                    <!-- Botón detalle -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_ver_completa"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Ver normativa completa"
                        app:cornerRadius="8dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</LinearLayout>